# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=poker777
MYSQL_USER=poker
MYSQL_PASSWORD=pokerpass

# Frontend
VITE_API_BASE=http://localhost:4000

# Backend
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Production ALB -> Nginx -> internal ALB chain; local dev uses the default 0.
# TRUST_PROXY_HOPS=3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=mysql
DB_PORT=3306
DB_USER=poker
DB_PASSWORD=pokerpass
DB_NAME=poker777
DB_CONNECTION_LIMIT=10
# Production only: DB_SSL_CA=/etc/ssl/certs/aws-rds-global-bundle.pem

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false
# Set only when the Redis deployment requires an auth token.
REDIS_PASSWORD=
REDIS_KEY_PREFIX=poker:
# Optional but useful for logs and tracing when running multiple backend tasks.
INSTANCE_ID=backend-local

# Auth
JWT_SECRET=dev-only-change-me-in-production-please-32-chars-min
JWT_EXPIRES_IN=24h
JWT_ISSUER=poker777

# Game
WELCOME_BONUS=1000
TOPUP_MIN=1
TOPUP_MAX=100000
INTERNAL_API_KEY=dev-internal-key-change-me
