{
  "name": "poker777-backend",
  "version": "0.1.0",
  "description": "Poker777 Core API & Frontend Integration - Auth, Users, Lobby, Wallet (REST)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "migrate:fresh": "node src/scripts/migrate.js --fresh",
    "test": "cross-env NODE_ENV=test REDIS_DISABLED=1 node --test --test-concurrency=1 --test-reporter=spec --test-name-pattern='.' \"src/test/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0"
  }
}
