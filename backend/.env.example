# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# ---- CORS ----
# Comma-separated list of allowed origins (CloudFront + dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500

# ---- MySQL (RDS in prod; local container in dev) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=poker
DB_PASSWORD=pokerpass
DB_NAME=poker777
DB_CONNECTION_LIMIT=10

# ---- Redis (ElastiCache in prod; local container in dev) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_KEY_PREFIX=poker:

# ---- Auth / JWT ----
# CHANGE THIS in production (use AWS Secrets Manager / SSM Parameter Store)
JWT_SECRET=dev-only-change-me-in-production-please-32-chars-min
JWT_EXPIRES_IN=24h
JWT_ISSUER=poker777

# ---- Game / Economy ----
WELCOME_BONUS=1000
TOPUP_MIN=1
TOPUP_MAX=100000

# ---- Internal API (for WebSocket team to call settlement) ----
# Shared with the Game team — must match their config
INTERNAL_API_KEY=dev-internal-key-change-me
