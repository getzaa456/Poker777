# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# ---- CORS ----
# Comma-separated list of allowed origins (CloudFront + dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://localhost:3000

# ---- MySQL (RDS in prod; local container in dev) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=poker
DB_PASSWORD=pokerpass
DB_NAME=poker777
DB_CONNECTION_LIMIT=10
# Optional: RDS read replica endpoints, comma-separated. Room lists and history pages read from
# them; everything else (balances, login, writes) stays on DB_HOST. Leave empty to use DB_HOST only.
DB_READ_HOSTS=

# ---- Redis (ElastiCache in prod; local container in dev) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_KEY_PREFIX=poker:

# ---- Auth / JWT ----
# CHANGE THIS in production (use AWS Secrets Manager / SSM Parameter Store)
JWT_SECRET=dev-only-change-me-in-production-please-32-chars-min
JWT_EXPIRES_IN=24h
JWT_ISSUER=poker777

# ---- Game / Economy ----
WELCOME_BONUS=1000
# Optional: free chips (watch a clip, pick 1 of 3 boxes). Defaults shown.
# REWARD_WATCH_SECONDS=10
# REWARD_MAX_BALANCE=100        # only players with less than this in the wallet can claim
# REWARD_COOLDOWN_SECONDS=300
# REWARD_DAILY_LIMIT=5

# ---- Internal API (for WebSocket team to call settlement) ----
# Shared with the Game team — must match their config
INTERNAL_API_KEY=dev-internal-key-change-me
